# Snag environment variables
# Copy this file to .env and fill in the values.
# The .env file is git-ignored.

# --- Authentication ---------------------------------------------------------
# Set both to enable login. If either is missing, the app runs open (no auth)
# and the first browser visit shows the "create account" setup page.
#
# When set, these override the in-browser setup (useful for Docker deploys
# where you want fixed credentials without the first-visit flow).
SNAG_USER=
SNAG_PASSWORD=

# --- Session signing key (optional) -----------------------------------------
# Auto-generated and stored in the SQLite database on first start if not
# provided. Set it explicitly if you want sessions to survive a DB wipe.
# SNAG_SECRET=

# --- Storage ----------------------------------------------------------------
# Where downloaded media files are saved (inside the container).
# DOWNLOAD_DIR=/data
# Where the SQLite auth database (snag.db) is stored. In Docker this is a
# separate volume so auth data never appears in the downloads list.
# SNAG_CONFIG_DIR=/config

# --- Server -----------------------------------------------------------------
# Port the app listens on (container-internal).
# PORT=8000
