# ===========================================================================
# Snag - Docker build context (project root)
#
# Keeps local artifacts out of the image. The Dockerfile only needs
# Main.py, gunicorn.conf.py, requirements.txt and frontend/.
# ===========================================================================

# Runtime artifacts
downloads/
__pycache__/
*.pyc
.DS_Store

# VCS + docs (not needed in the image)
.git/
.gitignore
docs/
README.md
YT-DLP_FLAGS_REFERENCE.md

# Docker files themselves
docker/
Dockerfile
.dockerignore
